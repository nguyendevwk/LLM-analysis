# LLM Test Generation Analysis — provider keys (free tiers)
#
# Copy this file to `.env` (repository root) and fill in the keys you have.
# Only ONE key is required to run experiments; add more to compare providers.
# `.env` is gitignored — never commit real keys.

# Google Gemini API (AI Studio free tier) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenRouter (free models end with ':free') — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Groq (open-weight models, free developer tier) — https://console.groq.com/keys
GROQ_API_KEY=

# InternAI / Discovery API — optional
# INTERNAI_API_KEY=

# Local OpenAI-compatible server (Ollama / LM Studio / vLLM) — optional
# LOCAL_API_KEY=
# LOCAL_BASE_URL=http://localhost:11434/v1

# --- Optional request settings (defaults shown) -------------------------
# LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=0              # 0/empty = omit the client-side limit
# LLM_RECOVERY_MAX_TOKENS=0     # same behavior for the empty-response retry
# LLM_TIMEOUT=300
# LLM_MAX_RETRIES=4

# --- Optional provider endpoint overrides -------------------------------
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
